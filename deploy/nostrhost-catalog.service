[Unit]
Description=NostrHost native catalogue synchronizer
After=network-online.target nostrhost-relay.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/nostrhost/catalogue.env
ExecStart=/usr/bin/nostrhost-catalog --state ${NOSTRHOST_CATALOG_STATE} --publishers ${NOSTRHOST_CATALOG_PUBLISHERS} --relay ${NOSTRHOST_CATALOG_RELAYS} --logo-dir /usr/share/yunohost/applogos sync
Restart=on-failure
RestartSec=5s
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/nostrhost /usr/share/yunohost/applogos

[Install]
WantedBy=multi-user.target
